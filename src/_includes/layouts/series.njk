---
layout: layouts/base.njk
---
{#
  Platform hub. A page only supplies `platformSlug`; everything below is
  generated from site.platforms and the tutorial source of truth, so a newly
  published step appears here as soon as its record exists.
#}
{%- set platform = site.platforms | findBy("slug", platformSlug) %}
{%- set steps = catalogue.byPlatform[platformSlug] %}
{%- set crumbs = [
      { label: "Home", url: "/" },
      { label: "Tutorials", url: "/tutorials/" },
      { label: platform.name, url: platform.url }
    ] %}

<section class="page-head">
  <div class="shell">
    {%- include "components/breadcrumbs.njk" %}
    <div class="page-head-inner">
      <p class="eyebrow eyebrow-on-dark">Learning path</p>
      <h1 class="page-title">{{ platform.series }}</h1>
      <p class="page-lede">{{ platform.description }}</p>
      <p class="meta-row meta-row-on-dark u-mt-6">
        <span>{{ platform.status }}</span>
        <span>Playlist: {{ platform.playlistTitle }}</span>
      </p>
      <p class="cta-row u-mt-6">
        <a class="btn btn-ghost" href="{{ platform.playlistUrl }}"
           data-event="playlist_open" rel="noopener">Open the YouTube playlist</a>
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <header class="section-head">
      <h2 class="section-title-sm">{{ steps.length }} published step{% if steps.length != 1 %}s{% endif %}, in learning order</h2>
      <p class="section-lede">{{ content | safe }}</p>
    </header>

    <ol class="series-rail">
      {%- for tutorial in steps %}
        {%- include "components/series-step.njk" %}
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section section-sunken section-tight">
  <div class="shell">
    <h2 class="section-title-sm">Keep going</h2>
    <p class="section-lede">Browse the full catalogue across both platforms, or find companion command guides for tutorials that include them.</p>
    <p class="cta-row u-mt-6">
      <a class="btn btn-primary" href="/tutorials/">Browse all tutorials</a>
      <a class="btn btn-ghost" href="/guides/">Companion guides</a>
    </p>
  </div>
</section>

<script type="application/ld+json">{{ crumbs | breadcrumbSchema(site.url) | jsonld | safe }}</script>
<script type="application/ld+json">{{ {
  name: platform.series,
  description: platform.description,
  url: site.url + platform.url,
  listName: platform.series,
  items: steps | collectionItems(site.url)
} | collectionSchema | jsonld | safe }}</script>
